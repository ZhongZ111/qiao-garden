---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About · ZhangQiao">
  <main class="min-h-screen flex flex-col items-center justify-center px-6">
    <div class="max-w-md w-full space-y-10">

      <!-- Name -->
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">ZhangQiao</h1>
      </div>

      <!-- Bio -->
      <div class="space-y-4 text-sm text-gray-600 leading-relaxed">
        <p>
          在「知识」和「人」之间流窜，对两边都半信半疑。<br />
          同时，正在成为 AI 的工具。
        </p>
      </div>

      <!-- AI Progress -->
      <div class="space-y-2">
        <div class="flex justify-between text-xs text-gray-400">
          <span>AI 学习进度</span>
          <span>入门阶段 · 1%</span>
        </div>
        <div class="w-full bg-gray-100 rounded-full h-1.5">
          <div class="bg-black h-1.5 rounded-full" style="width: 1%"></div>
        </div>
      </div>

      <!-- Contact -->
      <div class="space-y-4">
        <p class="text-xs text-gray-400 uppercase tracking-widest">Contact</p>
