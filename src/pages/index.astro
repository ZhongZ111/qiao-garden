---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Qiao Zhang">
  <main class="min-h-screen flex flex-col items-center justify-center px-6">
    <div class="max-w-md w-full text-center space-y-8">

      <!-- Name -->
      <h1 class="text-2xl font-semibold tracking-tight">Qiao Zhang</h1>

      <!-- One-line intro -->
      <p class="text-base text-gray-500">
        我们必须坚强、快乐，才能去帮助需要帮助的人。<br />
        <span class="text-gray-400 text-sm">Er urteilt also, daß er etwas kann, darum weil er sich bewußt ist, daß er es soll, und erkennt in sich die Freiheit, die ihm sonst ohne das moralische Gesetz unbekannt geblieben wäre.</span>
      </p>

      <!-- Navigation -->
      <nav class="flex justify-center gap-8 text-sm">
        <a href="/about" class="text-gray-400 hover:text-black transition-colors">About</a>
        <a href="/notes" class="text-gray-400 hover:text-black transition-colors">Notes</a>
        <a href="/works" class="text-gray-400 hover:text-black transition-colors">Works</a>
      </nav>

    </div>
  </main>
</Layout>
